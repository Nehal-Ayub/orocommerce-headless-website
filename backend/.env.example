APP_NAME=Oro Headless Middleware
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-secret
SESSION_TTL=86400
CACHE_TTL=300
HTTP_TIMEOUT_SECONDS=30

# Oro OAuth token endpoint.
ORO_OAUTH_TOKEN_URL=https://your-orocommerce.example.com/oauth2-token
ORO_CLIENT_ID=your-oro-client-id
ORO_CLIENT_SECRET=your-oro-client-secret
# Backward-compatible aliases (either pair can be used)
ORO_API_CLIENT_ID=your-oro-client-id
ORO_API_CLIENT_SECRET=your-oro-client-secret
ORO_SCOPE=default

# Oro JSON:API base (can be root host OR include /api).
ORO_API_BASE_URL=https://your-orocommerce.example.com/api
ORO_CHECKOUT_API_BASE_URL=https://your-orocommerce.example.com/api

# resource_owner = validate buyer credentials against Oro OAuth password grant
# client = issue app token only, then resolve user/company from Oro APIs
ORO_AUTH_MODE=resource_owner
